<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>

    <!-- A small number of Moroccan broadcasters still publish their live audio only over HTTP.
         Keep cleartext disabled globally and permit it only for these verified streaming hosts. -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">radiotangermed-22.ice.infomaniak.ch</domain>
        <domain includeSubdomains="true">broadcast.ice.infomaniak.ch</domain>
        <domain includeSubdomains="true">aswat.ice.infomaniak.ch</domain>
        <domain includeSubdomains="true">broadcast.infomaniak.ch</domain>
        <domain includeSubdomains="true">broadcast.infomaniak.net</domain>
        <domain includeSubdomains="true">cdnamd-hls-globecast.akamaized.net</domain>
    </domain-config>
</network-security-config>
