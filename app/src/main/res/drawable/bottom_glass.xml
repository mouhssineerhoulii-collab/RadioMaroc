<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item><shape><solid android:color="#22FFFFFF"/><corners android:radius="30dp"/></shape></item>
    <item android:left="1dp" android:right="1dp" android:top="1dp" android:bottom="1dp">
        <shape>
            <gradient android:startColor="#A3132E42" android:endColor="#8F0E1C2B" android:angle="0"/>
            <stroke android:width="1dp" android:color="#A5F8D990"/>
            <corners android:radius="29dp"/>
        </shape>
    </item>
</layer-list>
