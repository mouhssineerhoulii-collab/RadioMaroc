<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape>
            <solid android:color="#20FFFFFF"/>
            <corners android:radius="22dp"/>
        </shape>
    </item>
    <item android:left="1dp" android:right="1dp" android:top="1dp" android:bottom="1dp">
        <shape>
            <gradient android:startColor="#B5142E40" android:centerColor="#A70C2233" android:endColor="#96101A2A" android:angle="0"/>
            <stroke android:width="1dp" android:color="#B6F6D17C"/>
            <corners android:radius="21dp"/>
            <padding android:left="12dp" android:top="10dp" android:right="12dp" android:bottom="10dp"/>
        </shape>
    </item>
</layer-list>
