<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape>
            <solid android:color="#5CD7A84B" />
            <corners android:radius="18dp" />
        </shape>
    </item>
    <item android:left="1dp" android:right="1dp" android:top="1dp" android:bottom="1dp">
        <shape>
            <gradient android:startColor="#F00B2A3E" android:endColor="#F0061E2F" android:angle="270" />
            <stroke android:width="1dp" android:color="#66F4D58A" />
            <corners android:radius="17dp" />
            <padding android:left="12dp" android:top="9dp" android:right="12dp" android:bottom="9dp" />
        </shape>
    </item>
</layer-list>
