<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape>
            <solid android:color="#28FFE7A2"/>
            <corners android:radius="22dp"/>
        </shape>
    </item>
    <item android:left="1dp" android:right="1dp" android:top="1dp" android:bottom="1dp">
        <shape>
            <gradient android:startColor="#A66B481B" android:centerColor="#915A3C16" android:endColor="#7D452C10" android:angle="0"/>
            <stroke android:width="1dp" android:color="#DDF8D990"/>
            <corners android:radius="21dp"/>
            <padding android:left="12dp" android:top="10dp" android:right="12dp" android:bottom="10dp"/>
        </shape>
    </item>
</layer-list>
