<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape>
            <solid android:color="#18F7D38A"/>
            <corners android:radius="22dp"/>
        </shape>
    </item>
    <item android:left="1dp" android:right="1dp" android:top="1dp" android:bottom="1dp">
        <shape>
            <gradient android:startColor="#5A17334A" android:centerColor="#4410283A" android:endColor="#32102131" android:angle="0"/>
            <stroke android:width="1dp" android:color="#88F6D17C"/>
            <corners android:radius="21dp"/>
            <padding android:left="12dp" android:top="10dp" android:right="12dp" android:bottom="10dp"/>
        </shape>
    </item>
</layer-list>
