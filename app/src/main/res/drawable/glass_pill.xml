<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item><shape><solid android:color="#42FFFFFF"/><corners android:radius="32dp"/></shape></item>
    <item android:left="1dp" android:right="1dp" android:top="1dp" android:bottom="1dp">
        <shape>
            <gradient android:startColor="#6A173B50" android:centerColor="#4A0B2739" android:endColor="#66102030" android:angle="0"/>
            <stroke android:width="1dp" android:color="#B8E6D3A0"/>
            <corners android:radius="31dp"/>
        </shape>
    </item>
</layer-list>
