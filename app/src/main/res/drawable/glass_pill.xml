<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item><shape><solid android:color="#20FFFFFF"/><corners android:radius="32dp"/></shape></item>
    <item android:left="1dp" android:right="1dp" android:top="1dp" android:bottom="1dp">
        <shape>
            <gradient android:startColor="#551B3C53" android:centerColor="#3F122B3D" android:endColor="#32102131" android:angle="0"/>
            <stroke android:width="1dp" android:color="#99F8D990"/>
            <corners android:radius="31dp"/>
        </shape>
    </item>
</layer-list>
