<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Warm translucent scrim inside the dialog: enough contrast for white text without a black panel. -->
    <item>
        <shape>
            <solid android:color="#A04A3826"/>
            <stroke android:width="5dp" android:color="#2AFFD76A"/>
            <corners android:radius="32dp"/>
        </shape>
    </item>
    <!-- Clear warm glass + crisp luminous gold rim. -->
    <item android:left="3dp" android:right="3dp" android:top="3dp" android:bottom="3dp">
        <shape>
            <gradient android:startColor="#8C6A5034" android:centerColor="#96513D2A" android:endColor="#8C6A5034" android:angle="45"/>
            <stroke android:width="1.7dp" android:color="#FFFFD66B"/>
            <corners android:radius="29dp"/>
            <padding android:left="10dp" android:top="10dp" android:right="10dp" android:bottom="10dp"/>
        </shape>
    </item>
</layer-list>