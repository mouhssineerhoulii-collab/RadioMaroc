<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
 <item><shape><solid android:color="#3DFFFFFF"/><corners android:radius="28dp"/></shape></item>
 <item android:left="1dp" android:right="1dp" android:top="1dp" android:bottom="1dp">
  <shape>
   <gradient android:startColor="#50FFFFFF" android:centerColor="#3DEFF1F2" android:endColor="#34FFFFFF" android:angle="45"/>
   <stroke android:width="2dp" android:color="#F2FFFFFF"/>
   <corners android:radius="27dp"/>
   <padding android:left="8dp" android:top="8dp" android:right="8dp" android:bottom="8dp"/>
  </shape>
 </item>
 <item android:left="3dp" android:right="3dp" android:top="3dp" android:bottom="3dp">
  <shape><stroke android:width="1dp" android:color="#18F8D990"/><corners android:radius="25dp"/></shape>
 </item>
</layer-list>