<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
 <item><shape><solid android:color="#704A5056"/><corners android:radius="28dp"/></shape></item>
 <item android:left="1dp" android:right="1dp" android:top="1dp" android:bottom="1dp">
  <shape>
   <gradient android:startColor="#865F6469" android:centerColor="#76575D63" android:endColor="#6E4F555B" android:angle="45"/>
   <stroke android:width="1dp" android:color="#E8F4F1E8"/>
   <corners android:radius="27dp"/>
   <padding android:left="8dp" android:top="8dp" android:right="8dp" android:bottom="8dp"/>
  </shape>
 </item>
 <item android:left="2dp" android:right="2dp" android:top="2dp" android:bottom="2dp">
  <shape><stroke android:width="1dp" android:color="#26F8D990"/><corners android:radius="26dp"/></shape>
 </item>
</layer-list>