<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Clear Moroccan glass: background remains visible, with only a very light warm tint. -->
    <item>
        <shape>
            <solid android:color="#263A2C20"/>
            <corners android:radius="30dp"/>
        </shape>
    </item>
    <!-- Bright polished-gold rim matching the approved visual reference. -->
    <item android:left="1dp" android:right="1dp" android:top="1dp" android:bottom="1dp">
        <shape>
            <gradient
                android:startColor="#305C4930"
                android:centerColor="#223B342C"
                android:endColor="#305C4930"
                android:angle="45"/>
            <stroke android:width="2dp" android:color="#FFFFD66B"/>
            <corners android:radius="29dp"/>
            <padding android:left="8dp" android:top="8dp" android:right="8dp" android:bottom="8dp"/>
        </shape>
    </item>
</layer-list>
