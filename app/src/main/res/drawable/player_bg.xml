<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape>
            <solid android:color="#E614344B"/>
            <corners android:radius="28dp"/>
        </shape>
    </item>
    <item android:left="1dp" android:right="1dp" android:top="1dp" android:bottom="1dp">
        <shape>
            <gradient android:startColor="#F2234B65" android:centerColor="#E8173852" android:endColor="#E70C263A" android:angle="0"/>
            <stroke android:width="2dp" android:color="#FFF8D990"/>
            <corners android:radius="27dp"/>
        </shape>
    </item>
</layer-list>
