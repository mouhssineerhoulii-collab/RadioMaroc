<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape>
            <solid android:color="#66734A18"/>
            <corners android:radius="28dp"/>
        </shape>
    </item>
    <item android:left="1dp" android:right="1dp" android:top="1dp" android:bottom="1dp">
        <shape>
            <gradient android:startColor="#C88A5A1F" android:centerColor="#B8754B19" android:endColor="#A0603A12" android:angle="0"/>
            <stroke android:width="2dp" android:color="#FFF8D990"/>
            <corners android:radius="27dp"/>
        </shape>
    </item>
</layer-list>
