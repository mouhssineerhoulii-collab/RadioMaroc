<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape>
            <solid android:color="#33FFD98A"/>
            <corners android:radius="26dp"/>
        </shape>
    </item>
    <item android:left="1dp" android:right="1dp" android:top="1dp" android:bottom="1dp">
        <shape>
            <gradient android:startColor="#D914334B" android:centerColor="#C9102B40" android:endColor="#B90A2236" android:angle="0"/>
            <stroke android:width="1dp" android:color="#99FFD98A"/>
            <corners android:radius="25dp"/>
        </shape>
    </item>
</layer-list>
