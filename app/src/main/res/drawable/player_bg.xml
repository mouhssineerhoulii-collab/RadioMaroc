<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape>
            <solid android:color="#66D7A84B" />
            <corners android:radius="22dp" />
        </shape>
    </item>
    <item android:left="1dp" android:right="1dp" android:top="1dp" android:bottom="1dp">
        <shape>
            <gradient android:startColor="#0D3650" android:centerColor="#092B42" android:endColor="#061D2E" android:angle="0" />
            <stroke android:width="1dp" android:color="#88F4D58A" />
            <corners android:radius="21dp" />
        </shape>
    </item>
</layer-list>
