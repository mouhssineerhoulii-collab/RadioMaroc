<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape>
            <solid android:color="#22F6D17C"/>
            <corners android:radius="28dp"/>
        </shape>
    </item>
    <item android:left="1dp" android:right="1dp" android:top="1dp" android:bottom="1dp">
        <shape>
            <gradient android:startColor="#661A3A52" android:centerColor="#55132D43" android:endColor="#44102436" android:angle="0"/>
            <stroke android:width="1dp" android:color="#99F8D990"/>
            <corners android:radius="27dp"/>
        </shape>
    </item>
</layer-list>
