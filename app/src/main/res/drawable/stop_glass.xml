    <item><shape><solid android:color="#22C1272D"/><corners android:radius="26dp"/></shape></item>
    <item android:left="1dp" android:right="1dp" android:top="1dp" android:bottom="1dp">
        <shape>
            <gradient android:startColor="#7AB01F2E" android:endColor="#5A7B1620" android:angle="0"/>
            <stroke android:width="1dp" android:color="#88F8D990"/>
            <corners android:radius="25dp"/>
        </shape>
    </item>
