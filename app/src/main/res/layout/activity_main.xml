<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/morocco_background">

    <LinearLayout
        android:id="@+id/header"
        android:layout_width="match_parent"
        android:layout_height="144dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/zellige_header"
        android:paddingStart="18dp"
        android:paddingEnd="18dp"
        android:paddingTop="14dp"
        android:paddingBottom="12dp">

        <ImageView
            android:layout_width="58dp"
            android:layout_height="58dp"
            android:src="@drawable/ic_app"
            android:contentDescription="Radio Maroc" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="14dp"
            android:paddingEnd="12dp">

            <TextView
                android:id="@+id/appTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Radio Maroc"
                android:textColor="@color/cream"
                android:textStyle="bold"
                android:textSize="30sp" />

            <TextView
                android:id="@+id/appSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Moroccan voices, everywhere with you"
                android:textColor="@color/gold_light"
                android:textSize="12sp"
                android:layout_marginTop="3dp" />
        </LinearLayout>

        <TextView
            android:id="@+id/settingsButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:gravity="center"
            android:text="⚙"
            android:textSize="24sp"
            android:textColor="@color/cream"
            android:background="@drawable/search_glass"
            android:contentDescription="Settings" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:paddingTop="12dp">

        <EditText
            android:id="@+id/searchBox"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:singleLine="true"
            android:hint="Search stations…"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:background="@drawable/search_glass"
            android:textColor="@color/text"
            android:textColorHint="@color/muted"
            android:textSize="16sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="10dp">

            <Button
                android:id="@+id/allButton"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:text="All"
                android:textAllCaps="false"
                android:textColor="@color/cream"
                android:backgroundTint="@color/surface_alt" />

            <Button
                android:id="@+id/favoritesButton"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:text="Favorites"
                android:textAllCaps="false"
                android:textColor="@color/cream"
                android:backgroundTint="@color/surface_alt" />

            <Button
                android:id="@+id/recentButton"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:text="Recent"
                android:textAllCaps="false"
                android:textColor="@color/cream"
                android:backgroundTint="@color/surface_alt" />

            <Button
                android:id="@+id/viewButton"
                android:layout_width="52dp"
                android:layout_height="44dp"
                android:text="☰"
                android:textSize="20sp"
                android:textAllCaps="false"
                android:textColor="@color/gold_light"
                android:backgroundTint="@color/surface_alt" />
        </LinearLayout>
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:clipToPadding="false"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:paddingTop="8dp"
        android:paddingBottom="4dp">

        <GridLayout
            android:id="@+id/stationsGrid"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:columnCount="1"
            android:alignmentMode="alignMargins"
            android:useDefaultMargins="false" />
    </ScrollView>

    <LinearLayout
        android:id="@+id/playerBox"
        android:layout_width="match_parent"
        android:layout_height="92dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/player_bg"
        android:padding="11dp"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="8dp">

        <ImageView
            android:id="@+id/playerLogo"
            android:layout_width="62dp"
            android:layout_height="62dp"
            android:padding="3dp"
            android:background="@drawable/logo_bg"
            android:scaleType="centerInside"
            android:src="@drawable/ic_app"
            android:contentDescription="Station" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="12dp"
            android:paddingEnd="8dp">

            <TextView
                android:id="@+id/nowPlayingLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="NOW PLAYING"
                android:textColor="@color/gold_light"
                android:textStyle="bold"
                android:textSize="10sp" />

            <TextView
                android:id="@+id/nowPlaying"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Choose a station"
                android:textColor="@color/cream"
                android:textStyle="bold"
                android:textSize="18sp"
                android:ellipsize="end"
                android:maxLines="1" />

            <TextView
                android:id="@+id/status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Stopped"
                android:textColor="@color/muted"
                android:textSize="11sp" />
        </LinearLayout>

        <Button
            android:id="@+id/toggleButton"
            android:layout_width="54dp"
            android:layout_height="54dp"
            android:text="▶"
            android:textSize="20sp"
            android:textColor="@color/bg"
            android:backgroundTint="@color/gold_light" />

        <Button
            android:id="@+id/stopButton"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:text="■"
            android:textSize="17sp"
            android:textColor="#FFFFFF"
            android:backgroundTint="@color/red" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/bottomNav"
        android:layout_width="match_parent"
        android:layout_height="68dp"
        android:orientation="horizontal"
        android:gravity="center"
        android:background="@drawable/nav_glass"
        android:paddingStart="8dp"
        android:paddingEnd="8dp">

        <Button
            android:id="@+id/homeNavButton"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="⌂\nHome"
            android:textAllCaps="false"
            android:textSize="12sp"
            android:textColor="@color/gold_light"
            android:backgroundTint="#00000000" />

        <Button
            android:id="@+id/favoritesNavButton"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="♡\nFavorites"
            android:textAllCaps="false"
            android:textSize="12sp"
            android:textColor="@color/cream"
            android:backgroundTint="#00000000" />

        <Button
            android:id="@+id/settingsNavButton"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="⚙\nSettings"
            android:textAllCaps="false"
            android:textSize="12sp"
            android:textColor="@color/cream"
            android:backgroundTint="#00000000" />
    </LinearLayout>
</LinearLayout>
