<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/moroccan_night_bg"
    android:paddingStart="10dp"
    android:paddingEnd="10dp">

    <LinearLayout
        android:id="@+id/header"
        android:layout_width="match_parent"
        android:layout_height="168dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="10dp"
        android:paddingEnd="6dp"
        android:paddingTop="22dp">

        <ImageView
            android:layout_width="86dp"
            android:layout_height="86dp"
            android:src="@drawable/ic_app"
            android:contentDescription="Radio Maroc" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="12dp"
            android:paddingEnd="8dp">

            <TextView
                android:id="@+id/appTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Radio Maroc"
                android:textColor="@color/cream"
                android:textStyle="bold"
                android:textSize="34sp"
                android:fontFamily="serif"
                android:shadowColor="#99000000"
                android:shadowDx="0"
                android:shadowDy="2"
                android:shadowRadius="5" />

            <TextView
                android:id="@+id/appSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Moroccan voices, everywhere with you"
                android:textColor="#D8E6F1"
                android:textSize="13sp"
                android:layout_marginTop="1dp" />
        </LinearLayout>

        <TextView
            android:id="@+id/settingsButton"
            android:layout_width="54dp"
            android:layout_height="54dp"
            android:gravity="center"
            android:text="⚙"
            android:textSize="25sp"
            android:textColor="@color/cream"
            android:background="@drawable/play_circle" />
    </LinearLayout>

    <EditText
        android:id="@+id/searchBox"
        android:layout_width="match_parent"
        android:layout_height="58dp"
        android:singleLine="true"
        android:hint="Search stations…"
        android:paddingStart="22dp"
        android:paddingEnd="22dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:background="@drawable/glass_pill"
        android:textColor="@color/text"
        android:textColorHint="#B7C9D8"
        android:textSize="17sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="10dp"
        android:paddingStart="14dp"
        android:paddingEnd="14dp">

        <Button
            android:id="@+id/allButton"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="All"
            android:textAllCaps="false"
            android:textStyle="bold"
            android:textColor="#071A28"
            android:background="@drawable/tab_active" />

        <Button
            android:id="@+id/favoritesButton"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="Favorites"
            android:textAllCaps="false"
            android:textColor="#E5EDF4"
            android:background="@drawable/tab_inactive" />

        <Button
            android:id="@+id/recentButton"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="Recent"
            android:textAllCaps="false"
            android:textColor="#E5EDF4"
            android:background="@drawable/tab_inactive" />

        <Button
            android:id="@+id/viewButton"
            android:layout_width="58dp"
            android:layout_height="48dp"
            android:text="☰"
            android:textSize="20sp"
            android:textAllCaps="false"
            android:textColor="#071A28"
            android:background="@drawable/tab_active" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:paddingStart="7dp"
        android:paddingEnd="7dp"
        android:paddingTop="4dp">

        <GridLayout
            android:id="@+id/stationsGrid"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:columnCount="1"
            android:alignmentMode="alignMargins"
            android:useDefaultMargins="false" />
    </ScrollView>

    <LinearLayout
        android:id="@+id/playerBox"
        android:layout_width="match_parent"
        android:layout_height="90dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/player_bg"
        android:padding="10dp"
        android:layout_marginStart="5dp"
        android:layout_marginEnd="5dp"
        android:layout_marginTop="3dp"
        android:layout_marginBottom="7dp">

        <ImageView
            android:id="@+id/playerLogo"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_app"
            android:background="@drawable/logo_bg"
            android:contentDescription="Station" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="10dp"
            android:paddingEnd="8dp">

            <TextView
                android:id="@+id/nowPlayingLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="NOW PLAYING"
                android:textColor="@color/gold_light"
                android:textStyle="bold"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/nowPlaying"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Choose a station"
                android:textColor="@color/cream"
                android:textStyle="bold"
                android:textSize="18sp"
                android:ellipsize="end"
                android:maxLines="1" />

            <TextView
                android:id="@+id/status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Stopped"
                android:textColor="#B7C9D8"
                android:textSize="11sp" />
        </LinearLayout>

        <Button
            android:id="@+id/toggleButton"
            android:layout_width="54dp"
            android:layout_height="54dp"
            android:text="▶"
            android:textSize="20sp"
            android:textColor="@color/gold_light"
            android:background="@drawable/play_circle" />

        <Button
            android:id="@+id/stopButton"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:text="■"
            android:textSize="16sp"
            android:textColor="#FFFFFF"
            android:backgroundTint="#B61E2D" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/bottomNav"
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:orientation="horizontal"
        android:gravity="center"
        android:background="@drawable/bottom_glass"
        android:layout_marginStart="5dp"
        android:layout_marginEnd="5dp"
        android:layout_marginBottom="6dp"
        android:paddingStart="8dp"
        android:paddingEnd="8dp">

        <Button
            android:id="@+id/homeNavButton"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="⌂\nHome"
            android:textAllCaps="false"
            android:textSize="12sp"
            android:textColor="@color/gold_light"
            android:backgroundTint="#00000000" />

        <Button
            android:id="@+id/favoritesNavButton"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="♡\nFavorites"
            android:textAllCaps="false"
            android:textSize="12sp"
            android:textColor="#F0F5F8"
            android:backgroundTint="#00000000" />

        <Button
            android:id="@+id/settingsNavButton"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="⚙\nSettings"
            android:textAllCaps="false"
            android:textSize="12sp"
            android:textColor="#F0F5F8"
            android:backgroundTint="#00000000" />
    </LinearLayout>
</LinearLayout>
