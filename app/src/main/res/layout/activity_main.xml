<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg"
    android:layoutDirection="rtl"
    android:padding="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:background="@drawable/header_bg"
        android:padding="18dp"
        android:layout_marginBottom="12dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="✦  راديو المغرب  ✦"
            android:textColor="@color/navy"
            android:textStyle="bold"
            android:textSize="29sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="إذاعات مغربية مباشرة"
            android:textColor="@color/gold"
            android:textStyle="bold"
            android:textSize="15sp"
            android:layout_marginTop="3dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="المغرب صوت يجمعنا"
            android:textColor="@color/muted"
            android:textSize="13sp"
            android:layout_marginTop="5dp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/playerBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/player_bg"
        android:padding="16dp"
        android:layout_marginBottom="12dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="الآن على الهواء"
            android:textColor="@color/gold"
            android:textStyle="bold"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/nowPlaying"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="اختر محطة للبدء"
            android:textColor="@color/navy"
            android:textStyle="bold"
            android:textSize="22sp"
            android:layout_marginTop="3dp" />

        <TextView
            android:id="@+id/status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="متوقف"
            android:textColor="@color/muted"
            android:textSize="14sp"
            android:layout_marginTop="3dp" />

        <Button
            android:id="@+id/stopButton"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:text="■  إيقاف البث"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:background="@drawable/stop_button"
            android:layout_marginTop="11dp" />
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="✦  جميع المحطات"
        android:textColor="@color/navy"
        android:textStyle="bold"
        android:textSize="22sp"
        android:paddingStart="5dp"
        android:paddingEnd="5dp"
        android:layout_marginBottom="2dp" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:id="@+id/stationsContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </ScrollView>
</LinearLayout>
