<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="#07131B">
    <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:src="@drawable/moroccan_background" android:scaleType="centerCrop" android:alpha="0.22" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:gravity="center" android:padding="22dp">
        <Button android:id="@+id/driverExit" android:layout_width="match_parent" android:layout_height="56dp" android:text="✕  QUITTER • خروج" android:textSize="18sp" android:textStyle="bold" android:textColor="#FFFFFF" android:background="@drawable/tab_inactive" />
        <Space android:layout_width="1dp" android:layout_height="0dp" android:layout_weight="1" />
        <TextView android:id="@+id/driverStation" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Radio Maroc" android:textColor="#FFFFFF" android:textSize="32sp" android:textStyle="bold" android:gravity="center" android:maxLines="2" />
        <TextView android:id="@+id/driverState" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="ARRÊT • متوقف" android:textColor="#F6C85F" android:textSize="18sp" android:textStyle="bold" android:gravity="center" android:layout_marginTop="12dp" />
        <Space android:layout_width="1dp" android:layout_height="0dp" android:layout_weight="1" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="112dp" android:orientation="horizontal" android:gravity="center">
            <Button android:id="@+id/driverPrevious" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="◀" android:textSize="40sp" android:textColor="#FFFFFF" android:background="@drawable/tab_inactive" />
            <Button android:id="@+id/driverPlay" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1.25" android:text="▶" android:textSize="46sp" android:textColor="#0A1820" android:background="@drawable/tab_active" />
            <Button android:id="@+id/driverNext" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="▶|" android:textSize="34sp" android:textColor="#FFFFFF" android:background="@drawable/tab_inactive" />
        </LinearLayout>
        <Button android:id="@+id/driverStop" android:layout_width="match_parent" android:layout_height="76dp" android:text="■  ARRÊTER • إيقاف" android:textSize="22sp" android:textStyle="bold" android:textColor="#FFFFFF" android:background="@drawable/stop_glass" android:layout_marginTop="14dp" />
        <Space android:layout_width="1dp" android:layout_height="0dp" android:layout_weight="1" />
    </LinearLayout>
</FrameLayout>
